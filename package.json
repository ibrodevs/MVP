{
  "name": "bte-global",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "check": "node scripts/check.js",
    "dev:demo": "node scripts/dev.js --demo",
    "build": "node scripts/build.js",
    "test:postgres": "node --env-file-if-exists=.env.test.local --test tests/postgres/*.test.js",
    "migrate:preview": "node --env-file-if-exists=.env.preview.local scripts/migrate.js"
  },
  "dependencies": {
    "@vercel/oidc": "^5.0.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11",
    "@playwright/test": "^1.56.1",
    "lucide-static": "^0.468.0",
    "prettier": "^3.10.1",
    "smtp-server": "^3.21.7"
  }
}
