# Base. Node.js 24 is pinned in package.json. No Ziina settings are required.
APP_BASE_URL=http://localhost:3000
# Required only for availability, reservation, status, payment processing and worker.
# Public GET /api/consultations/config does not depend on this connection.
DATABASE_URL=postgresql://user:password@localhost:5432/bte
# Required for Neon migrations: direct endpoint, never the -pooler hostname.
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/bte

# disabled in Production (mock is rejected there even if configured by mistake).
# Preview testing: mock + separate PostgreSQL + CALENDAR_MODE/EMAIL_MODE=mock.
PAYMENT_MODE=disabled
CALENDAR_MODE=google
EMAIL_MODE=smtp
BOOKING_DEMO_SCHEDULE=false

# Real Calendar adapter; not needed when CALENDAR_MODE=mock in local/Preview.
GOOGLE_CALENDAR_ID=808bte@gmail.com
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Real email adapter; port 587 with mandatory STARTTLS and verified TLS >=1.2.
# SMTP_PASSWORD: enter directly as Sensitive in Vercel Preview; see docs/SMTP.md.
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=projects@bteglobal.ae
SMTP_PASSWORD=
EMAIL_FROM=projects@bteglobal.ae
BOOKING_NOTIFICATION_EMAIL=projects@bteglobal.ae

# Approved schedule: Monday-Friday, 10:00-19:00 Dubai (GMT+4).
# Explicitly empty working fields can still close scheduling.
BOOKING_TIMEZONE=Asia/Dubai
BOOKING_SLOT_MINUTES=30
BOOKING_RESERVATION_TTL_MINUTES=15
BOOKING_HORIZON_DAYS=60
BOOKING_MIN_LEAD_MINUTES=120
BOOKING_WORK_DAYS=1,2,3,4,5
BOOKING_WORK_START=10:00
BOOKING_WORK_END=19:00

# Authenticate the worker/scheduler. Vercel cron: daily fallback, 03:00 UTC.
CRON_SECRET=

# OPTIONAL independent distributed limiter for public config (HTTPS Redis REST).
# Set both or neither. Without these: bounded instance limiter + CDN caching.
# A deployment-wide quota requires Redis or a separately configured edge/WAF rule.
CONFIG_RATE_LIMIT_REDIS_REST_URL=
CONFIG_RATE_LIMIT_REDIS_REST_TOKEN=

# VERCEL / VERCEL_ENV / VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_TARGET_ENV
# are Vercel system variables. Do not set NODE_ENV=development to enable Preview.
# TEST_DATABASE_URL is only for npm run test:postgres, not a deployment setting.

# npm run test:postgres loads ignored .env.test.local. Set only a dedicated
# Preview branch direct URL there; production/unknown Neon hosts are rejected.
TEST_DATABASE_URL=
